# Clé API Google Gemini, à obtenir sur https://aistudio.google.com/apikey
# IMPORTANT : utiliser un projet en niveau PAYANT (facturation activée).
# En niveau gratuit, Google peut utiliser les contenus envoyés pour améliorer ses produits,
# ce qui est inacceptable pour des confidences de santé mentale.
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle de conversation (API Gemini). Gemma 4 26B : le plus rapide (~1,4 s avant le premier mot).
# Option : gemma-4-31b-it (plus lent, souvent saturé). En cas de quota ou d'erreur, bascule
# automatique et invisible sur LLM_FALLBACK_MODEL.
LLM_MODEL=gemma-4-26b-a4b-it
LLM_FALLBACK_MODEL=gemini-2.5-flash

# Voix : webspeech (défaut : voix du navigateur, instantanée et gratuite), auto (Gemini TTS si configuré,
# sinon navigateur) ou gemini. En niveau gratuit, Gemini TTS est limité à 3 requêtes/min.
NEXT_PUBLIC_TTS_PROVIDER=webspeech

# Lecture vocale Gemini TTS (optionnelle), voir https://ai.google.dev/gemini-api/docs/speech-generation
# Sans ces deux variables, /api/tts répond 503 et l'app utilise la voix du navigateur.
# flash-lite : plus rapide (~1 s avant le premier son en streaming) et ~33 % moins cher que gemini-3.8-flash-tts
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Vindemiatrix

# Optionnel : plafond de caractères lus par jour et par utilisateur (défaut : 15000)
# TTS_DAILY_CHAR_LIMIT=15000
