# Clé API Google Gemini — obtenir sur https://aistudio.google.com/apikey
# IMPORTANT : utiliser un projet en niveau PAYANT (facturation activée).
# En niveau gratuit, Google peut utiliser les contenus envoyés pour améliorer ses produits,
# ce qui est inacceptable pour des confidences de santé mentale.
GEMINI_API_KEY=your_gemini_api_key_here

# Lecture vocale (Gemini TTS) — voir https://ai.google.dev/gemini-api/docs/speech-generation
# Sans ces deux variables, /api/tts répond 503 et l'app utilise la voix du navigateur.
# flash-lite : plus rapide (~1 s avant le premier son en streaming) et ~33 % moins cher que gemini-3.8-flash-tts
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Vindemiatrix

# Optionnel : plafond de caractères lus par jour et par utilisateur (défaut : 15000)
# TTS_DAILY_CHAR_LIMIT=15000
